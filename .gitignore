# dependencies
node_modules/

# builds
dist/
.next/
out/
build/
.turbo/
*.tsbuildinfo

# test + tooling output
coverage/
playwright-report/
test-results/
.playwright/

# packaged tarballs
*.tgz

# deploy
.vercel/

