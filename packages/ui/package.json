{
  "name": "@cairnkit/ui",
  "version": "0.6.0",
  "description": "Prebuilt Cairn overlay: spotlight, step card and launcher. Plain CSS, light and dark.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/index.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cairnkit/core": "workspace:*",
    "@cairnkit/react": "workspace:*",
    "@floating-ui/dom": "^1.6.13"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "keywords": [
    "product-tour",
    "onboarding",
    "walkthrough",
    "spotlight",
    "react"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cairnkit/cairnkit.git",
    "directory": "packages/ui"
  },
  "homepage": "https://cairnkit.dev",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
