{
  "name": "@cairnkit/react",
  "version": "0.12.4",
  "description": "Headless React bindings for cairnkit. No styling, no router assumptions.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && node ../../scripts/client-directive.mjs apply",
    "dev": "tsup --watch --onSuccess \"node ../../scripts/client-directive.mjs apply\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cairnkit/core": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "keywords": [
    "product-tour",
    "onboarding",
    "walkthrough",
    "user-onboarding",
    "guided-tour",
    "spotlight",
    "coachmark",
    "product-adoption",
    "react",
    "nextjs",
    "typescript",
    "developer-tools",
    "ci"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cairnkit/cairnkit.git",
    "directory": "packages/react"
  },
  "homepage": "https://cairnkit.dev",
  "bugs": {
    "url": "https://github.com/cairnkit/cairnkit/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
