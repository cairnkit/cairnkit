{
  "name": "cairnkit",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "preinstall": "npx --yes only-allow pnpm",
    "build": "pnpm -r --filter \"./packages/**\" build",
    "dev": "pnpm -r --parallel --filter \"./packages/**\" dev",
    "typecheck": "pnpm -r --filter \"./packages/**\" typecheck",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish",
    "test:init": "pnpm --filter @cairnkit/cli build && bash scripts/init-matrix.sh",
    "test:docs": "bash scripts/docs-matrix.sh",
    "size": "node scripts/measure-size.mjs",
    "size:check": "node scripts/measure-size.mjs --check",
    "audit:published": "node scripts/audit-published.mjs --audit-level high"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prettier": "^3.4.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4",
    "jsdom": "^25.0.1",
    "@testing-library/react": "^16.1.0",
    "@testing-library/dom": "^10.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@types/react": "^19.0.0",
    "@changesets/cli": "^2.27.11"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.23",
      "sharp": "^0.35.0"
    }
  }
}
